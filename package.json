{
  "name": "javadoc-mcp",
  "version": "1.0.4",
  "description": "MCP server for browsing JavaDoc documentation via Maven coordinates",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loong95/javadoc-mcp.git"
  },
  "homepage": "https://github.com/loong95/javadoc-mcp#readme",
  "bugs": {
    "url": "https://github.com/loong95/javadoc-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "javadoc",
    "java",
    "maven"
  ],
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "javadoc-mcp": "dist/index.js",
    "javadoc-cli": "dist/cli.js"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "prepack": "npm run build",
    "prepublishOnly": "npm test",
    "test": "npm run build && node --test test/*.test.mjs",
    "start": "node dist/index.js",
    "dev": "tsc --watch"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "adm-zip": "^0.5.16",
    "cheerio": "^1.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}
